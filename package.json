{
  "name": "obsidian-csvzall",
  "version": "0.10.2",
  "description": "A fast CSV viewer, editor, and charting tool.",
  "main": "main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincentlaucsb/obsidian-csvzall.git"
  },
  "scripts": {
    "check:line-endings": "node scripts/check-line-endings.mjs",
    "fix:line-endings": "node scripts/check-line-endings.mjs --fix",
    "dev": "node esbuild.config.mjs",
    "build": "npm run check:wasm-viewer && node esbuild.config.mjs production",
    "build:mobile": "node scripts/build-mobile.mjs",
    "sync:wasm-viewer": "node scripts/sync-wasm-viewer.mjs && npm run patch:wasm-viewer",
    "refresh:wasm-viewer": "node scripts/refresh-wasm-viewer.mjs",
    "sync:mobile-repo": "node scripts/sync-mobile-repo.mjs",
    "setup:mobile-demo": "node scripts/setup-mobile-demo-vault.mjs",
    "patch:wasm-viewer": "node scripts/patch-wasm-viewer-bridge.mjs",
    "check:wasm-viewer": "node scripts/check-wasm-viewer.mjs",
    "check:bundled-helper": "node scripts/check-bundled-helper.mjs",
    "check:helper-snapshot": "node scripts/native-helper-contract.mjs verify",
    "sync:bundled-helper": "node scripts/sync-native-binaries.mjs",
    "check:mobile": "node scripts/check-mobile-dist.mjs",
    "test": "npm run test:unit && npm run test:mobile",
    "test:unit": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js tests/native-helper-pipeline.test.mjs tests/bundled-payloads.test.mjs",
    "test:mobile": "npm run build:mobile && npm run check:mobile && node --test tests/mobile-*.test.mjs",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
    "test:coverage": "npm run build && tsc -p tsconfig.test.json && node --test --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info .test-build/tests/*.test.js tests/native-helper-pipeline.test.mjs tests/bundled-payloads.test.mjs",
    "lint": "node scripts/lint.mjs",
    "review:obsidian": "node scripts/prepare-obsidian-review.mjs",
    "check:source-archive": "node scripts/check-source-archive.mjs"
  },
  "keywords": [
    "obsidian",
    "csv",
    "csvzall"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@types/commonmark": "^0.27.10",
    "@types/node": "^16.11.6",
    "esbuild": "0.25.5",
    "eslint": "10.10.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "ignore": "^5.3.2",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "commonmark": "^0.31.2",
    "obsidian": "1.13.1"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
